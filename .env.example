APP_NAME=NETSIGHT
APP_ENV=local
APP_DEBUG=true
APP_URL=https://netsight.local
SHOW_DEMO_BUTTON=false

# GitHub Token for Docker builds (if pulling private composer dependencies locally)
# GITHUB_TOKEN=your_personal_access_token_here

# ==============================================================================
# IMPORTANT: DO NOT STORE ACTUAL CREDENTIALS HERE
# ==============================================================================
# Per SECURITY.md and AGENT.md, actual credentials must not be stored in plain text.
# 
# In production, use Docker Secrets. 
# Create the following files in docker/secrets/ (which is gitignored):
# - db_password
# - redis_password
# - app_key
# 
# The application reads from /run/secrets/ in the container.
#
# Do NOT put your actual APP_KEY here if this file is committed.
APP_KEY=base64:placeholder_replace_via_docker_secret

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (PostgreSQL 18 via Docker)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=netsight
DB_USERNAME=netsight
# DB_PASSWORD is provided via /run/secrets/db_password

# Redis 8.6 via Docker
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD is provided via /run/secrets/redis_password

# Horizon / Queue
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
CACHE_STORE=redis

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=480 # 8 hours per SECURITY.md
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# NETSIGHT Guardrails
# These map to config/netsight.php
NETSIGHT_TORCH_CPU_THRESHOLD=80
NETSIGHT_TORCH_CPU_WARNING=60
NETSIGHT_TORCH_MAX_CONCURRENT=2
NETSIGHT_TORCH_SESSION_TIMEOUT=120
NETSIGHT_TORCH_HEARTBEAT_TTL=10
NETSIGHT_TORCH_HEARTBEAT_REFRESH=5
NETSIGHT_TORCH_RACE_WINDOW=2

NETSIGHT_SYNC_MAX_PARALLEL=5
NETSIGHT_SYNC_CB_THRESHOLD=3
NETSIGHT_SYNC_COOLDOWN_MINUTES=15
NETSIGHT_SYNC_RATE_LIMIT_MINUTES=5

NETSIGHT_API_TIMEOUT=5
NETSIGHT_API_MAX_RETRIES=3
NETSIGHT_API_DEFAULT_PORT=8729

NETSIGHT_AUTH_SESSION_TIMEOUT=8
NETSIGHT_AUTH_PASSWORD_MIN_LENGTH=12
NETSIGHT_AUTH_TOTP_WINDOW=1

NETSIGHT_WATCHDOG_INTERVAL=15
SENTRY_LARAVEL_DSN=

# GenieACS Configuration
GENIEACS_NBI_URL=http://genieacs:7557
GENIEACS_NBI_SECRET=netsight_genieacs_secret_key
GENIEACS_CWMP_PORT=9090